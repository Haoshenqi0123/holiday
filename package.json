{
  "name": "holiday-worker",
  "version": "1.0.0",
  "private": true,
  "description": "法定节假日查询 API 的 Cloudflare Workers 版本",
  "scripts": {
    "dev": "node scripts/link-kv.mjs --dev && wrangler dev -c wrangler.gen.jsonc",
    "deploy": "node scripts/link-kv.mjs && wrangler deploy -c wrangler.gen.jsonc",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "workerd@1.20261006.1": true
  }
}
